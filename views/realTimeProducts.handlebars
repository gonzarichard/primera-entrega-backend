<h1>Productos en tiempo real</h1>

<ul id="productList"></ul>

<h2>Agregar producto</h2>

<input id="title" placeholder="titulo" />
<input id="price" placeholder="precio" />

<button onclick="addProduct()">Agregar</button>

<script src="/socket.io/socket.io.js"></script>

<script>
  const socket = io() const list = document.getElementById("productList")
  socket.on("products", products => { list.innerHTML = "" products.forEach(p =>
  { const li = document.createElement("li") li.innerText = p.title + " - $" +
  p.price list.appendChild(li) }) }) function addProduct(){ const title =
  document.getElementById("title").value const price =
  document.getElementById("price").value socket.emit("addProduct", { title,
  price }) }
</script>